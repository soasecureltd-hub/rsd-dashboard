# Database URL.
# Local/dev default is SQLite:
#   DATABASE_URL=sqlite:///./rsd.db
# Production uses Supabase Postgres via the *Session pooler* connection string
# (Supabase dashboard -> Connect -> Session pooler). The direct host
# db.<project-ref>.supabase.co is IPv6-only and unreachable from Render.
# URL-encode special characters in the password ('$' -> '%24', '@' -> '%40').
#   DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./rsd.db

# FastAPI Configuration
# Keep DEBUG=False in any non-local environment (exposes stack traces otherwise).
DEBUG=True
API_TITLE=Risk-Security Diagnostic API
API_VERSION=1.0.0

# JWT Authentication
# REQUIRED in production. Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start when DEBUG=False and this is unset.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ML Model Path
MODEL_PATH=security_multiorg_model.pkl

# Error monitoring (optional)
SENTRY_DSN=

# CORS Origins: comma-separated, no brackets or quotes (add your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Optional regex for origins you can't list, e.g. Vercel preview deployments:
#   ALLOWED_ORIGIN_REGEX=^https://rsd-frontend(-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
